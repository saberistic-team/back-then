# Copy to .env.local for local development. Never commit real credentials.
DEPLOYMENT_ENV=local
ENVIRONMENT_ID=backthen-local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase local defaults are printed by `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=backthen-local
SUPABASE_SERVICE_ROLE_KEY=

# Local development never uses live billing or email delivery.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ANNUAL_PRICE_ID=
EMAIL_DELIVERY_MODE=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# All features default off. These two flags are permitted only locally.
FEATURE_DEMO_DATA=false
FEATURE_LOCAL_BILLING_BYPASS=false
FEATURE_AI_DERIVED=false
FEATURE_WEEKLY_DELIVERY=false
FEATURE_VOICE_TRANSCRIPTION=false
