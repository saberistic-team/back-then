{
  "name": "backthen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.23.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "env:check": "node --import tsx scripts/check-environment.ts",
    "env:verify-matrix": "node --import tsx scripts/verify-environment-matrix.ts",
    "fixtures:validate": "node --import tsx scripts/validate-demo-fixtures.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:fixtures": "node --import tsx scripts/load-demo-fixtures.ts",
    "db:setup": "pnpm db:reset && pnpm db:fixtures",
    "db:verify": "node --import tsx scripts/verify-database.ts"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.2",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
